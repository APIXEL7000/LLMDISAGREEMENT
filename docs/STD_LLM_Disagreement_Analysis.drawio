<mxCell id="s4" value="&lt;b&gt;Querying LLMs (P2)&lt;/b&gt;&lt;hr size=&quot;1&quot; style=&quot;margin:3px 0&quot;&gt;&lt;div style=&quot;text-align:left;padding:0 6px;&quot;&gt;entry / send each prompt to every selected model&lt;br&gt;do / collect real responses; retry failures&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1370" y="170" width="200" height="120" as="geometry"/></mxCell>
